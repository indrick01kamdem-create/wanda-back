# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://wanda:wanda123@localhost:5432/wanda

# JWT
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudinary (KYC documents upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
APP_ENV=development
APP_NAME=Wanda API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Payment — "mock" pour le développement, "fapshi" en production
PAYMENT_PROVIDER=mock

# Fapshi
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://live.fapshi.com
FAPSHI_SANDBOX_URL=https://sandbox.fapshi.com
FAPSHI_REDIRECT_URL=
FAPSHI_WEBHOOK_SECRET=

# SMS provider: "twilio" | "avlytext" | "textbee"
SMS_PROVIDER=avlytext

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SID=

# AvlyText (OTP SMS)
AVLYTEXT_API_KEY=
AVLYTEXT_SENDER=Wanda

# TextBee (OTP SMS via gateway Android)
TEXTBEE_BASE_URL=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SUBSCRIPTION_ID_ORANGE=4
TEXTBEE_SUBSCRIPTION_ID_MTN=5
TEXTBEE_FALLBACK_PROVIDER=avlytext
